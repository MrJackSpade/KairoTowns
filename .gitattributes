# Every Kairo app's .gitattributes (shared/tools/check-app.sh requires it to match this file).
*.md text eol=lf
*.sh text eol=lf
*.proftext text eol=lf

.gitattributes text eol=lf

# The byte-exact rules come last so they win over the ones above: a vendored .sh committed with
# CRLF otherwise shows as modified in every fresh checkout, which stops a rebase there.
# Preserve vendored source bytes, including Shift-JIS text and original line endings.
third_party/** -text
# Generated catalogs carry checksums of their exact bytes.
catalog/** -text
# Packaged assets ship as committed on every platform (audit_android_release.py).
*/src/main/assets/** -text
