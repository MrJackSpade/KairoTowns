#!/bin/sh
set -eu

# Commits made by rebase, cherry-pick, filter-branch or --no-verify skip the
# commit hooks, so check every commit this push would publish.
zero=0000000000000000000000000000000000000000
remote=$1
hooks=$(dirname "$0")
message=$(mktemp)
trap 'rm -f "$message"' EXIT
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    # The tag build publishes nothing without the tag's release notes, so check before the tag leaves.
    case "$remote_ref" in
        refs/tags/v*)
            tag=${remote_ref#refs/tags/}
            # Every Kairo app releases the version in the shared commit this tag pins.
            pin=$(git rev-parse "$local_sha^{commit}:shared")
            if version=$(git -C shared show "$pin:release-version" 2>/dev/null); then
                sh shared/tools/check-release-version.sh "$tag" "$version" || status=1
            else
                echo "Tag $tag: shared/release-version is missing at the pinned shared commit $pin (fetch shared?)" >&2
                status=1
            fi
            notes="docs/releases/$tag.md"
            if ! git cat-file -e "$local_sha^{commit}:$notes" 2>/dev/null ||
                [ "$(git cat-file -s "$local_sha^{commit}:$notes")" -eq 0 ]; then
                echo "Tag $tag has no release notes: $notes is missing or empty in its commit" >&2
                status=1
            fi
            ;;
    esac
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=$remote"
    else
        range="$remote_sha..$local_sha"
    fi
    for commit in $(git rev-list $range); do
        identities=$(git log -1 --format='%an <%ae>%n%cn <%ce>' "$commit" | sort -u)
        case "$identities" in
            'MrJackSpade <loffredo.ap@gmail.com>') ;;
            # The Discord sync workflow commits its own state files.
            'github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>') ;;
            *)
                echo "Commit $commit for $remote_ref is by:" >&2
                echo "$identities" >&2
                status=1
                ;;
        esac
        git log -1 --format=%B "$commit" > "$message"
        "$hooks/check-commit-message" "$message" "Commit $commit for $remote_ref" || status=1
    done
done

exit $status
